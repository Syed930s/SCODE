#!/usr/bin/env bash

APP="$1"

if [[ -z "$APP" ]]; then
    echo "Usage: flatpurge <flatpak.app.id>"
    exit 1
fi

echo "→ Checking for Flatpak app: $APP"

FLATPAK_MATCH=$(flatpak list --app --columns=application | grep -Fx "$APP")

if [[ -z "$FLATPAK_MATCH" ]]; then
    echo "❌ ERROR: '$APP' is not installed as a Flatpak."
    exit 1
fi

echo "✔ Detected Flatpak application: $APP"
echo "→ Uninstalling Flatpak…"
flatpak uninstall -y "$APP"

# Sandbox cleanup
FP_PATH="$HOME/.var/app/$APP"

echo ""
echo "→ Checking for leftover sandbox data…"

if [[ -d "$FP_PATH" ]]; then
    echo "Found: $FP_PATH"
    read -p "Delete this directory? (y/N): " CONFIRM
    if [[ "$CONFIRM" == "y" || "$CONFIRM" == "Y" ]]; then
        rm -rf "$FP_PATH"
        echo "Deleted: $FP_PATH"
    else
        echo "Skipped: $FP_PATH"
    fi
else
    echo "No leftover sandbox data found."
fi

echo ""
echo "✔ Flatpak purge complete."
